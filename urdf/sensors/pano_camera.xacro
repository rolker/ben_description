<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="pano_camera" params="name number x:=0.1 y:=0 z:=0 R:=0 P:=0 Y:=0">

    <!-- Monocular Camera -->
    <link name="${namespace}/${name}_${number}">
      <visual name="${name}_${number}_visual">
        <origin xyz="0.018 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.042"/>
        </geometry>
      </visual>
      <collision name="${name}_lens_collision">
        <origin xyz="0.018 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.042"/>
        </geometry>
      </collision>
      <!-- Near-zero inertia: sensor mass is accounted for in hull_mass -->
      <inertial>
        <mass value="0.01"/>
        <inertia
          ixx="0.0001"
          iyy="0.0001"
          izz="0.0001"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>
    </link>

    <!-- Optical frame oriented in camera convention (ENU -> camera) -->
    <link name="${namespace}/${name}_${number}_optical">
    </link>

    <!-- Single joint from pano housing to camera.
         The old two-joint chain rotated first then translated in the rotated frame.
         Here we compute the translation in the parent frame:
           tx = x*cos(Y) - y*sin(Y)
           ty = x*sin(Y) + y*cos(Y)
           tz = z
         (valid when R=P=0, which is the case for all pano cameras) -->
    <joint name="${namespace}/${name}_to_${name}_${number}_joint" type="fixed">
      <origin xyz="${x*cos(Y) - y*sin(Y)} ${x*sin(Y) + y*cos(Y)} ${z}" rpy="${R} ${P} ${Y}" />
      <parent link="${namespace}/${name}" />
      <child link="${namespace}/${name}_${number}" />
    </joint>

    <!-- Camera to optical frame joint -->
    <joint name="${namespace}/${name}_${number}_to_${name}_${number}_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
      <parent link="${namespace}/${name}_${number}" />
      <child link="${namespace}/${name}_${number}_optical" />
    </joint>

    <!-- Reference plane for rviz camera projection -->
    <link name="${namespace}/${name}_${number}_optical_rviz_mesh">
    </link>

    <joint name="${namespace}/${name}_${number}_optical_to_${name}_${number}_optical_rviz_mesh_joint" type="fixed">
      <origin xyz="0 0 10" rpy="0 0 0" />
      <parent link="${namespace}/${name}_${number}_optical" />
      <child link="${namespace}/${name}_${number}_optical_rviz_mesh" />
    </joint>

  </xacro:macro>
</robot>
