<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="ben_radar" params="name
                                        x:=0.7 y:=0 z:=1.5
                                        R:=0 P:=0 Y:=0">

    <!-- TF frame only — hull mesh already includes radar dome visual. -->
    <link name="${namespace}/${name}">
      <inertial>
        <mass value="0.01"/>
        <inertia
          ixx="0.0001"
          iyy="0.0001"
          izz="0.0001"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>
    </link>

    <joint name="${namespace}/base_link_to_${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}" />
      <parent link="${namespace}/base_link" />
      <child link="${namespace}/${name}" />
    </joint>
  </xacro:macro>
</robot>
