<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="ben">
  <xacro:arg name="namespace" default="ben"/>
  <xacro:property name="namespace" value="$(arg namespace)" scope="global" />

  <!-- ============================================================
       Survey offsets — UPDATE THIS SECTION AFTER RESURVEY
       All positions in meters.
       Source: OnShape CAD model
       ============================================================ -->

  <!-- Hull mass properties.
       GA drawing (ASV-396-7-000-i0001-01): 883 kg displacement, 0.40m draft.
       CG lowered from OnShape estimate to ~60% of draft above keel for
       typical monohull stability. In base_link frame CG_z = 0.186. -->
  <xacro:property name="hull_mass" value="883" />
  <xacro:property name="cg_x" value="-0.911" />
  <xacro:property name="cg_y" value="-0.018" />
  <xacro:property name="cg_z" value="-0.346" />
  <!-- Inertia estimated as uniform-density box from GA drawing dimensions
       (4.17m x 1.58m x 0.63m at 883 kg). OnShape CAD values were unreliable
       and off-diagonal products caused capsizing when amplified by sensor-mass
       merging during URDF-to-SDF fixed joint conversion. -->
  <xacro:property name="ixx" value="212.9" />
  <xacro:property name="ixy" value="0.0" />
  <xacro:property name="ixz" value="0.0" />
  <xacro:property name="iyy" value="1308.7" />
  <xacro:property name="iyz" value="0.0" />
  <xacro:property name="izz" value="1463.2" />

  <!-- POSMV MRU location relative to base_link.
       The visual/collision meshes were authored with their origin at this point,
       so the mesh geometry <origin> uses the same offset. -->
  <xacro:property name="mru_x" value="0.911" />
  <xacro:property name="mru_y" value="0.018" />
  <xacro:property name="mru_z" value="0.532" />

  <!-- Sensor positions, measured relative to the POSMV MRU reference point.
       Hull-mounted sensors are parented to base_link in the URDF, so their
       joint origins add the MRU offset (e.g. x="${mru_x + lidar_x}").
       POSMV-mounted sensors (gps, heading) are parented to motion_sensor
       and use these offsets directly. -->

  <!-- Lidar (hull-mounted, relative to MRU) -->
  <xacro:property name="lidar_x" value="-1.98" />
  <xacro:property name="lidar_y" value="0.0" />
  <xacro:property name="lidar_z" value="1.403" />

  <!-- Radar (hull-mounted, relative to MRU) -->
  <xacro:property name="radar_x" value="-1.8" />
  <xacro:property name="radar_y" value="0.0" />
  <xacro:property name="radar_z" value="1.3" />

  <!-- Panoramic camera array (hull-mounted, relative to MRU) -->
  <xacro:property name="pano_x" value="-1.98" />
  <xacro:property name="pano_y" value="0.0" />
  <xacro:property name="pano_z" value="1.266" />

  <!-- Forward camera (hull-mounted, relative to MRU) -->
  <xacro:property name="forward_camera_x" value="-1.307" />
  <xacro:property name="forward_camera_y" value="0.1" />
  <xacro:property name="forward_camera_z" value="0.742" />

  <!-- MBES (hull-mounted, on retractable ram, relative to MRU) -->
  <xacro:property name="mbes_x" value="-0.5" />
  <xacro:property name="mbes_y" value="0.0" />
  <xacro:property name="mbes_z" value="-0.4" />

  <!-- GPS (POSMV-mounted, relative to motion_sensor) -->
  <xacro:property name="gps_x" value="-0.953" />
  <xacro:property name="gps_y" value="0.103" />
  <xacro:property name="gps_z" value="0.628" />

  <!-- Heading sensor at motion_sensor origin (no offset) -->

  <!-- Jetdrive (stern, hull-mounted, relative to MRU) -->
  <xacro:property name="jetdrive_x" value="-1.1" />
  <xacro:property name="jetdrive_y" value="0.0" />
  <xacro:property name="jetdrive_z" value="-0.1" />

  <!-- ============================================================
       End of survey offsets
       ============================================================ -->

  <!-- base_link: hull frame at waterline reference.
       All hull-mounted sensors and the visual/collision mesh attach here. -->
  <link name="${namespace}/base_link">
    <visual>
      <!-- Mesh origin is at the POSMV MRU location -->
      <origin xyz="${mru_x} ${mru_y} ${mru_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ben_description/models/meshes/BEN_shell.dae"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="${mru_x} ${mru_y} ${mru_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ben_description/models/meshes/BEN_shell_collision.stl"/>
      </geometry>
    </collision>

    <inertial>
      <!-- CG in base_link frame = MRU offset + CG relative to MRU -->
      <origin xyz="${mru_x + cg_x} ${mru_y + cg_y} ${mru_z + cg_z}" rpy="0 0 0"/>
      <mass value="${hull_mass}"/>
      <inertia
        ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
        iyy="${iyy}" iyz="${iyz}"
        izz="${izz}"/>
    </inertial>
  </link>

  <!-- motion_sensor: POSMV MRU physical reference frame.
       GPS and heading sensor are parented here. -->
  <joint name="${namespace}/base_link_to_motion_sensor_joint" type="fixed">
    <parent link="${namespace}/base_link"/>
    <child link="${namespace}/motion_sensor"/>
    <origin xyz="${mru_x} ${mru_y} ${mru_z}" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}/motion_sensor">
    <inertial>
      <!-- Near-zero mass: sensor link is a reference frame only.
           Total displacement (883 kg) is accounted for in hull_mass. -->
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Hull-mounted sensors (positions converted from MRU-relative to base_link-relative) -->

  <xacro:include filename="$(find ben_description)/urdf/sensors/lidar.xacro" />
  <xacro:ben_lidar name="lidar"
    x="${mru_x + lidar_x}" y="${mru_y + lidar_y}" z="${mru_z + lidar_z}"/>

  <xacro:include filename="$(find ben_description)/urdf/sensors/radar.xacro" />
  <xacro:ben_radar name="radar"
    x="${mru_x + radar_x}" y="${mru_y + radar_y}" z="${mru_z + radar_z}"/>

  <xacro:include filename="$(find ben_description)/urdf/sensors/pano_array.xacro" />
  <xacro:pano_array name="pano"
    x="${mru_x + pano_x}" y="${mru_y + pano_y}" z="${mru_z + pano_z}"/>

  <xacro:include filename="$(find ben_description)/urdf/sensors/forward_camera.xacro" />
  <xacro:forward_camera name="forward_camera"
    x="${mru_x + forward_camera_x}" y="${mru_y + forward_camera_y}" z="${mru_z + forward_camera_z}"/>

  <xacro:include filename="$(find ben_description)/urdf/sensors/mbes.xacro" />
  <xacro:ben_mbes name="mbes"
    x="${mru_x + mbes_x}" y="${mru_y + mbes_y}" z="${mru_z + mbes_z}"/>

  <!-- POSMV-mounted sensors (positions relative to motion_sensor) -->

  <xacro:include filename="$(find ben_description)/urdf/sensors/oem_gps.xacro" />
  <xacro:oem_gps name="gps" x="${gps_x}" y="${gps_y}" z="${gps_z}"/>

  <xacro:include filename="$(find ben_description)/urdf/sensors/oem_heading_sensor.xacro" />
  <xacro:oem_heading_sensor name="heading"/>

  <!-- Jetdrive (Alamarin-Jet AJ 160 waterjet) -->

  <xacro:include filename="$(find ben_description)/urdf/jetdrive.xacro" />
  <xacro:ben_jetdrive name="jetdrive"
    x="${mru_x + jetdrive_x}" y="${mru_y + jetdrive_y}" z="${mru_z + jetdrive_z}"/>

</robot>
